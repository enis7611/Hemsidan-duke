# Sidorna och mallen byggs byte-identiskt med LF (mall/bygg-sida.ps1) – låt inte git göra om till CRLF.
*.html text eol=lf
*.ps1  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json -text
# Allt som servrar hämtar under /simulationsmcp/v1/ ska vara byte-exakt; guidernas HTML är vanlig text.
site/simulationsmcp/v1/** -text
site/simulationsmcp/v1/guides/**/*.html text eol=lf
